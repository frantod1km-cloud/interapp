# Copiar a .env.local y completar con valores reales

# Supabase — sacar de https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...

# Solo backend / webhooks. NUNCA exponer en el cliente.
SUPABASE_SERVICE_ROLE_KEY=ey...

# Mercado Pago
# Access token de la app: https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=

# Clave secreta del webhook, de la sección "Notificaciones" en el panel de tu
# app de MP. Si está vacío, el webhook acepta requests sin verificar firma
# (solo aceptable en desarrollo).
MP_WEBHOOK_SECRET=

# VAPID (web push). Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@interapp.com
