# ============================================================================
# interapp — Variables de entorno
# ============================================================================
# Copialo a .env.local (dev) o cargalo en Vercel → Settings → Environment
# Variables (prod). Las marcadas como NEXT_PUBLIC_* viajan al cliente.

# ────────────────────────────────────────────────────────────────────────────
# Supabase
# ────────────────────────────────────────────────────────────────────────────
# Las sacás de: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...

# Service role: NUNCA exponer al cliente. Solo backend.
SUPABASE_SERVICE_ROLE_KEY=ey...

# ────────────────────────────────────────────────────────────────────────────
# Dominio raíz (importante en producción)
# ────────────────────────────────────────────────────────────────────────────
# El dominio del que cuelgan los subdominios de los barrios.
# Si vas a usar interapp.com.ar como root y losalamos.interapp.com.ar,
# nordelta.interapp.com.ar, etc., poné:
#   NEXT_PUBLIC_ROOT_DOMAIN=interapp.com.ar
# Si lo dejás vacío, asumimos dev (localhost).
NEXT_PUBLIC_ROOT_DOMAIN=

# ────────────────────────────────────────────────────────────────────────────
# Mercado Pago
# ────────────────────────────────────────────────────────────────────────────
# Para suscripciones SaaS (interapp cobra a barrios).
# Sacalo de: https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=

# Secret para validar firma del webhook. Lo configurás en
# tu app de MP → Notificaciones → "Clave secreta".
MP_WEBHOOK_SECRET=

# ────────────────────────────────────────────────────────────────────────────
# VAPID (web push notifications)
# ────────────────────────────────────────────────────────────────────────────
# Generá con: npm run vapid
# El subject debe ser tu email real — los servidores de push lo usan
# para contactarte si hay abuso.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@TU-DOMINIO.com

# ────────────────────────────────────────────────────────────────────────────
# Cron jobs (Vercel)
# ────────────────────────────────────────────────────────────────────────────
# Secret para que solo Vercel Cron pueda invocar nuestros endpoints
# /api/cron/*. Vercel inyecta este header automáticamente cuando hay
# crons configurados en vercel.json. Generá uno random largo.
CRON_SECRET=

# ────────────────────────────────────────────────────────────────────────────
# Notas
# ────────────────────────────────────────────────────────────────────────────
# Después de cambiar variables en Vercel, hacé un redeploy para que las tome.
